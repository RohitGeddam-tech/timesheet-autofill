# Reference for every setting. You don't edit a file: run `timesheet config` (guided), or
#   timesheet config set KEY=value      timesheet config unset KEY      timesheet config list
# The password is NOT a setting. `timesheet config set-secret` stores it in Windows
# Credential Manager / macOS Keychain.

# --- Login
# The Frappe / ERPNext site you log in to
TS_URL=https://projects.yourcompany.com
# Your login email. If you sign in with Google, set a site password first.
TS_USER=you@yourcompany.com

# --- Work
# Project that every task and timesheet row is filed under
PROJECT=Strategic Gears
# Start of every task subject: "SG Network - Internal Console - PR Review & Merge - 7 Oct 2026"
SUBJECT_PREFIX=SG Network
# Repos to read, comma separated: key=owner/name|Label used in task subjects|branch PRs merge into
# (PRs merged into any other branch are ignored; leave the branch out to count them all)
REPOS=console=strategic-gears/sg-network-internal-console|Internal Console|staging,portal=strategic-gears/sg-network-external-portal|External Portal|develop
# Where tracking issues go for work that belongs to no repo: a key from REPOS, or any owner/name
TRACKING_REPO=
# Defaults for created tasks
TASK_PRIORITY=Low
TASK_MODULE=Customised
# Activity type when the kind of work is unknown, or the site has no matching type
DEFAULT_ACTIVITY=Customization / Development

# --- Day shape
# Names or numbers (1=Mon ... 7=Sun). The company holiday list and your leave are also checked.
WORK_DAYS=Mon,Tue,Wed,Thu,Fri
# The first row of the working day starts here (24h)
DAY_START=09:30
# Work that begins after lunch starts at the end of this window
LUNCH=13:00-14:00
# A pause this long in a Claude Code conversation ends one block of work and starts the next
IDLE_MINUTES=15
# Time zone of the site and of your day, as an offset from UTC
UTC_OFFSET=+05:30

# --- Polishing (needs Claude Code)
# true = typed text is always tidied through `claude -p`; --raw skips it once
POLISH=false
# Suggest --polish at the y/N step when you typed text without it
POLISH_HINT=true

# --- Daily job
# off | remind (popup when yesterday has no timesheet) | auto (creates yesterday's draft, never posts issues)
SCHEDULE=off
# Popups from the daily job
NOTIFY=true
